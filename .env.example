# Default: no OpenAI API billing. Speech runs locally and drafting uses the
# ChatGPT account signed into Codex.
PTC_AI_PROVIDER=subscription
PTC_LOCAL_WHISPER_MODEL=small.en

# Optional YouTube publishing settings
YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube-client.json
YOUTUBE_PLAYLIST_URL=
YOUTUBE_CATEGORY_ID=27

# Optional API mode only. It is never used while PTC_AI_PROVIDER=subscription.
# PTC_AI_PROVIDER=api
# OPENAI_API_KEY=
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_CONTENT_MODEL=gpt-5-mini
